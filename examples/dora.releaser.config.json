{
  "releaseBranch": "master",
  "remote": "origin",
  "versionFile": "package.json",
  "tagPrefix": "v",
  "commitMessage": "chore(release): v{{version}}",
  "tagMessage": "{{version}}",
  "npm": { "publish": false, "access": "public", "tag": null },
  "github": { "release": false, "draft": false },
  "replacements": [
    {
      "file": "apps/desktop/package.json",
      "find": { "pattern": "\\\"version\\\":\\s*\\\"[0-9]+\\.[0-9]+\\.[0-9]+\\\"", "flags": "g" },
      "replace": "\"version\": \"{{version}}\"",
      "expectedMatches": 1
    },
    {
      "file": "apps/desktop/src-tauri/tauri.conf.json",
      "find": { "pattern": "\\\"version\\\":\\s*\\\"[0-9]+\\.[0-9]+\\.[0-9]+\\\"", "flags": "g" },
      "replace": "\"version\": \"{{version}}\"",
      "expectedMatches": 1
    },
    {
      "file": "apps/desktop/src-tauri/Cargo.toml",
      "find": { "pattern": "^version = \\\"[0-9]+\\.[0-9]+\\.[0-9]+\\\"", "flags": "gm" },
      "replace": "version = \"{{version}}\"",
      "expectedMatches": 1
    },
    {
      "file": "apps/desktop/src-tauri/Cargo.lock",
      "find": {
        "pattern": "^name = \\\"dora\\\"\\nversion = \\\"[0-9]+\\.[0-9]+\\.[0-9]+\\\"",
        "flags": "gm"
      },
      "replace": "name = \"dora\"\nversion = \"{{version}}\"",
      "expectedMatches": 1
    }
  ]
}
